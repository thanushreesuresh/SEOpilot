# Copy this file to backend/.env. Put your key ONLY in that ignored local copy.
# Never add keys to this committed example or to NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Use google on networks synthesizing restricted NAT64 answers; system is default.
# Queries both DNS families over verified HTTPS; all IP/redirect restrictions stay.
SEOPILOT_CRAWL_DNS=system
# Opt in to unlimited daily/burst audit requests from verified localhost clients.
# Remote clients still have the normal allowance; AI/crawl/capacity limits remain.
SEOPILOT_LOCAL_UNLIMITED_AUDITS=false
# Server kill switch. false keeps real crawling/rules while making zero AI calls.
SEOPILOT_AI_ENABLED=true
# Global maximum paid requests across ALL IPs per rolling 24 hours (0 disables).
# Each audit uses at most 2: generation + review. Failed requests still count.
SEOPILOT_AI_DAILY_CALL_LIMIT=20
# Hard maximum output tokens PER request, including reasoning; allowed 512..2500.
OPENAI_MAX_OUTPUT_TOKENS=2500
# Optional database location; defaults to backend/.data/seopilot.db
SEOPILOT_DB=
# Usually leave blank. If set, both backend and frontend must use the SAME
# absolute path to a private token file. Generated automatically; never commit.
SEOPILOT_PROXY_TOKEN_FILE=
# Optional private GitHub App, installed on selected repositories only.
# Metadata read; Contents write; Pull requests write; Actions read. No other permissions.
GITHUB_APP_ID=
# Ignored server-side PEM file, e.g. C:/private/seopilot-app.pem. Never paste the key here.
GITHUB_APP_PRIVATE_KEY_PATH=
# Comma-separated GitHub account logins allowed to own connected repositories.
GITHUB_APP_OWNERS=thanushreesuresh
